@using SalesManagement.BLL.DTOs
@model IEnumerable<AttendanceReportDto>
@{
    ViewData["Title"] = "Báo Cáo Chấm Công";
    var employees = ViewBag.Employees as IEnumerable<EmployeeDropdownDto> ?? Enumerable.Empty<EmployeeDropdownDto>();
    var chartData = ViewBag.ChartData as IEnumerable<DailyWorkHoursDto> ?? Enumerable.Empty<DailyWorkHoursDto>();
    DateOnly fromDate = ViewBag.FromDate;
    DateOnly toDate   = ViewBag.ToDate;
    int? selEmpId     = ViewBag.SelectedEmployeeId as int?;

    // Pagination
    int pageSize = 15;
    int page = int.TryParse(Context.Request.Query["page"], out var p) && p > 0 ? p : 1;
    var pagedList = Model.Skip((page - 1) * pageSize).Take(pageSize).ToList();
    int totalPages = (int)Math.Ceiling(Model.Count() / (double)pageSize);

    // Summary stats
    int totalRecords = Model.Count();
    int lateCount = Model.Count(r => r.IsLate);
    int earlyCount = Model.Count(r => r.IsLeftEarly);
    double avgHours = totalRecords > 0 ? Model.Average(r => r.WorkHours) : 0;
}

@section Styles {
<style>
    .stat-card { border-radius: 16px; border: none; box-shadow: 0 2px 12px rgba(0,0,0,.08); }
    .stat-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items:center; justify-content:center; font-size:1.4rem; }
    .row-late { background: #fff7ed; }
    .row-early { background: #fef2f2; }
    .row-late-early { background: #fdf2ff; }
    .badge-late  { background:#fef3c7; color:#92400e; }
    .badge-early { background:#fee2e2; color:#991b1b; }
    .badge-ok    { background:#dcfce7; color:#166534; }
    .tbl-at thead th { background:#0f172a; color:#fff; white-space:nowrap; }
    .filter-card { border-radius:16px; border:none; box-shadow:0 2px 12px rgba(0,0,0,.08); }
    .chart-card  { border-radius:16px; border:none; box-shadow:0 2px 12px rgba(0,0,0,.08); }
    #attendanceChart { max-height: 280px; }
</style>
}

<div class="container-fluid py-4 px-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="fw-bold mb-0">📋 Báo Cáo Chấm Công</h1>
            <p class="text-muted small mt-1">Theo dõi giờ làm, đi muộn và về sớm của nhân viên</p>
        </div>
    </div>

    <!-- Filter -->
    <div class="card filter-card mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold small text-muted">Từ ngày</label>
                    <input type="date" name="fromDate" value="@fromDate.ToString("yyyy-MM-dd")"
                           class="form-control" id="fromDate" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold small text-muted">Đến ngày</label>
                    <input type="date" name="toDate" value="@toDate.ToString("yyyy-MM-dd")"
                           class="form-control" id="toDate" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold small text-muted">Nhân viên</label>
                    <select name="employeeId" class="form-select" id="employeeId">
                        <option value="">-- Tất cả nhân viên --</option>
                        @foreach (var emp in employees)
                        {
                            if (selEmpId == emp.EmployeeId)
                            {
                                <option value="@emp.EmployeeId" selected>
                                    @emp.FullName @(string.IsNullOrEmpty(emp.Department) ? "" : $"({emp.Department})")
                                </option>
                            }
                            else
                            {
                                <option value="@emp.EmployeeId">
                                    @emp.FullName @(string.IsNullOrEmpty(emp.Department) ? "" : $"({emp.Department})")
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-search me-1"></i>Lọc
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary Stats -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card stat-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-primary bg-opacity-10">📊</div>
                    <div>
                        <div class="small text-muted">Tổng bản ghi</div>
                        <div class="fw-bold fs-4">@totalRecords</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-warning bg-opacity-10">⏰</div>
                    <div>
                        <div class="small text-muted">Đi muộn</div>
                        <div class="fw-bold fs-4 text-warning">@lateCount</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-danger bg-opacity-10">🚪</div>
                    <div>
                        <div class="small text-muted">Về sớm</div>
                        <div class="fw-bold fs-4 text-danger">@earlyCount</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-success bg-opacity-10">⏱️</div>
                    <div>
                        <div class="small text-muted">Giờ làm TB</div>
                        <div class="fw-bold fs-4 text-success">@avgHours.ToString("0.0")h</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <!-- Table -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">
                        <i class="bi bi-table me-2 text-primary"></i>Chi tiết chấm công
                    </h6>
                    @if (!pagedList.Any())
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-calendar-x fs-1"></i>
                            <p class="mt-2">Không có dữ liệu chấm công trong khoảng thời gian này.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table tbl-at align-middle mb-0 rounded-3 overflow-hidden">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Nhân viên</th>
                                        <th>Ngày</th>
                                        <th>Check-in</th>
                                        <th>Check-out</th>
                                        <th>Giờ làm</th>
                                        <th>Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int stt = (page - 1) * pageSize + 1; }
                                    @foreach (var r in pagedList)
                                    {
                                        string rowCss = (r.IsLate && r.IsLeftEarly) ? "row-late-early"
                                                       : r.IsLate ? "row-late"
                                                       : r.IsLeftEarly ? "row-early"
                                                       : "";
                                        <tr class="@rowCss">
                                            <td class="text-muted">@(stt++)</td>
                                            <td>
                                                <div class="fw-semibold">@r.EmployeeName</div>
                                                <div class="small text-muted">@r.Department</div>
                                            </td>
                                            <td>@r.Date.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                @if (r.CheckInTime.HasValue)
                                                {
                                                    <span>@r.CheckInTime.Value.ToString("HH:mm")</span>
                                                    if (r.IsLate)
                                                    {
                                                        <span class="badge badge-late ms-1 rounded-pill small">
                                                            +@r.MinutesLate' muộn
                                                        </span>
                                                    }
                                                }
                                                else { <span class="text-muted">--</span> }
                                            </td>
                                            <td>
                                                @if (r.CheckOutTime.HasValue)
                                                {
                                                    <span>@r.CheckOutTime.Value.ToString("HH:mm")</span>
                                                    if (r.IsLeftEarly)
                                                    {
                                                        <span class="badge badge-early ms-1 rounded-pill small">
                                                            Về sớm
                                                        </span>
                                                    }
                                                }
                                                else { <span class="text-muted">--</span> }
                                            </td>
                                            <td>
                                                <span class="fw-semibold">@r.WorkHours.ToString("0.0")h</span>
                                            </td>
                                            <td>
                                                @{
                                                    string badgeCss = r.Status switch {
                                                        "Present" => "badge-ok",
                                                        "Late" => "badge-late",
                                                        "LeftEarly" => "badge-early",
                                                        _ => "bg-secondary text-white"
                                                    };
                                                    string statusLabel = r.Status switch {
                                                        "Present" => "Có mặt",
                                                        "Late" => "Đi muộn",
                                                        "LeftEarly" => "Về sớm",
                                                        "Absent" => "Vắng",
                                                        _ => r.Status ?? "--"
                                                    };
                                                }
                                                <span class="badge @badgeCss rounded-pill px-3 py-2 small">@statusLabel</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        @if (totalPages > 1)
                        {
                            <nav class="mt-3 d-flex justify-content-end">
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item @(page <= 1 ? "disabled" : "")">
                                        <a class="page-link" asp-action="Index"
                                           asp-route-page="@(page-1)"
                                           asp-route-fromDate="@fromDate.ToString("yyyy-MM-dd")"
                                           asp-route-toDate="@toDate.ToString("yyyy-MM-dd")"
                                           asp-route-employeeId="@selEmpId">
                                            <i class="bi bi-chevron-left"></i>
                                        </a>
                                    </li>
                                    @for (int i = 1; i <= totalPages; i++)
                                    {
                                        <li class="page-item @(i == page ? "active" : "")">
                                            <a class="page-link" asp-action="Index"
                                               asp-route-page="@i"
                                               asp-route-fromDate="@fromDate.ToString("yyyy-MM-dd")"
                                               asp-route-toDate="@toDate.ToString("yyyy-MM-dd")"
                                               asp-route-employeeId="@selEmpId">@i</a>
                                        </li>
                                    }
                                    <li class="page-item @(page >= totalPages ? "disabled" : "")">
                                        <a class="page-link" asp-action="Index"
                                           asp-route-page="@(page+1)"
                                           asp-route-fromDate="@fromDate.ToString("yyyy-MM-dd")"
                                           asp-route-toDate="@toDate.ToString("yyyy-MM-dd")"
                                           asp-route-employeeId="@selEmpId">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Chart -->
        <div class="col-lg-4">
            <div class="card chart-card h-100">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">
                        <i class="bi bi-bar-chart-line me-2 text-success"></i>Giờ làm theo ngày
                    </h6>
                    <canvas id="attendanceChart"></canvas>
                    @if (!chartData.Any())
                    {
                        <p class="text-center text-muted small mt-3">Không có dữ liệu để hiển thị chart.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Legend -->
<div class="container-fluid px-4 pb-4">
    <div class="d-flex flex-wrap gap-3 align-items-center">
        <span class="fw-semibold small text-muted">Chú thích:</span>
        <span class="badge badge-late rounded-pill px-3 py-2">⏰ Đi muộn</span>
        <span class="badge badge-early rounded-pill px-3 py-2">🚪 Về sớm</span>
        <span class="badge badge-ok rounded-pill px-3 py-2">✅ Đúng giờ</span>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    (function () {
        var chartData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartData.Select(d => new {
            date = d.Date.ToString("dd/MM"),
            hours = Math.Round(d.TotalWorkHours, 1),
            employees = d.TotalEmployees
        })));

        if (chartData.length === 0) return;

        var ctx = document.getElementById('attendanceChart');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: chartData.map(d => d.date),
                datasets: [{
                    label: 'Tổng giờ làm',
                    data: chartData.map(d => d.hours),
                    backgroundColor: 'rgba(59,130,246,0.7)',
                    borderColor: '#3b82f6',
                    borderWidth: 2,
                    borderRadius: 6,
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            afterLabel: function(ctx) {
                                return 'Nhân viên: ' + chartData[ctx.dataIndex].employees;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        title: { display: true, text: 'Giờ' },
                        grid: { color: 'rgba(0,0,0,0.05)' }
                    },
                    x: { grid: { display: false } }
                }
            }
        });
    })();
</script>
}
