@model SalesManagement.Web.Models.HomeProductViewModel

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="container py-5">
    <div class="section-title mb-5 text-center">
        <span class="text-primary fw-bold text-uppercase ls-1">Bộ Sưu Tập</span>
        <h2 class="display-5 fw-bold">Danh Sách Sản Phẩm</h2>
        <p class="text-muted w-75 mx-auto">Khám phá các sản phẩm chất lượng cao của chúng tôi.</p>
    </div>

    <div class="row">
        <!-- Sidebar - Categories -->
        <div class="col-lg-3 mb-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-grid-fill me-2"></i> Danh mục</h5>
                </div>
                <div class="list-group list-group-flush">
                    <a asp-action="Index" 
                       asp-route-sortOrder="@Model.SortOrder" 
                       asp-route-SearchString="@Model.SearchString"
                       class="list-group-item list-group-item-action py-3 d-flex align-items-center @(Model.CategoryId == null ? "active bg-primary-subtle border-primary-subtle text-primary fw-bold" : "")">
                        <i class="bi bi-collection me-3"></i> Tất cả sản phẩm
                    </a>
                    @foreach (var cat in Model.Categories)
                    {
                        <a asp-action="Index" 
                           asp-route-categoryId="@cat.CategoryId" 
                           asp-route-sortOrder="@Model.SortOrder" 
                           asp-route-SearchString="@Model.SearchString"
                           class="list-group-item list-group-item-action py-3 d-flex align-items-center @(Model.CategoryId == cat.CategoryId ? "active bg-primary-subtle border-primary-subtle text-primary fw-bold" : "")">
                            <i class="bi bi-chevron-right me-3 small"></i> @cat.Name
                        </a>
                    }
                </div>
            </div>

            <!-- Additional Filters (Optional) -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mt-4">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-funnel-fill me-2"></i> Trợ giúp</h5>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-0">Chọn danh mục phù hợp để thu hẹp phạm vi tìm kiếm của bạn.</p>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">
            <!-- Search & Sort Bar -->
            <div class="card card-modern mb-4 shadow-sm border-0 rounded-4">
                <div class="card-body p-3">
                    <form asp-action="Index" method="get" class="row g-2 align-items-center">
                        <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                        <div class="col-md-7">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-primary"></i></span>
                                <input type="text" name="SearchString" value="@Model.SearchString" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm sản phẩm...">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <select name="sortOrder" class="form-select" onchange="this.form.submit()">
                                <option value="">Mới nhất</option>
                                <option value="name_desc" selected="@(Model.SortOrder == "name_desc")">Tên: Z-A</option>
                                <option value="Price" selected="@(Model.SortOrder == "Price")">Giá: Thấp-Cao</option>
                                <option value="price_desc" selected="@(Model.SortOrder == "price_desc")">Giá: Cao-Thấp</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">Lọc</button>
                        </div>
                    </form>
                </div>
            </div>

            @if (Model.Products.Any())
            {
                <div class="row g-4">
                    @foreach (var item in Model.Products)
                    {
                        <div class="col-md-4 col-sm-6">
                            <div class="card h-100 card-modern product-card border-0 shadow-sm rounded-4 overflow-hidden">
                                <div class="position-relative overflow-hidden">
                                    @if (!string.IsNullOrEmpty(item.PrimaryImageUrl))
                                    {
                                        <a asp-controller="Home" asp-action="Details" asp-route-id="@item.ProductId" class="d-block ratio ratio-1x1">
                                            <img src="@item.PrimaryImageUrl" class="card-img-top product-img object-fit-cover" alt="@item.Name">
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Home" asp-action="Details" asp-route-id="@item.ProductId" class="d-block text-decoration-none ratio ratio-1x1">
                                            <div class="bg-light d-flex align-items-center justify-content-center text-muted card-img-top product-img h-100">
                                                <i class="bi bi-image fs-1 opacity-25"></i>
                                            </div>
                                        </a>
                                    }
                                    <div class="position-absolute top-0 end-0 p-2">
                                        <span class="badge bg-white text-primary shadow-sm rounded-pill px-2 py-1 small">@item.CategoryName</span>
                                    </div>
                                    
                                    <div class="product-overlay d-flex justify-content-center align-items-center gap-2">
                                        <a asp-controller="Home" asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-light rounded-circle shadow-sm p-2" title="Xem chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <button type="button" class="btn btn-primary rounded-circle shadow-sm p-2" onclick="addToCart(@item.ProductId)">
                                            <i class="bi bi-cart"></i>
                                        </button>
                                    </div>
                                </div>
                                
                                <div class="card-body d-flex flex-column p-3">
                                    <h6 class="card-title fw-bold text-truncate mb-1" title="@item.Name">
                                        <a asp-controller="Home" asp-action="Details" asp-route-id="@item.ProductId" class="text-decoration-none text-dark">@item.Name</a>
                                    </h6>
                                    <div class="mt-auto pt-2 d-flex justify-content-between align-items-end">
                                        <div>
                                            <span class="h6 mb-0 text-primary fw-bold">@((item.SellingPrice).ToString("N0", new System.Globalization.CultureInfo("vi-VN"))) <small>xu</small></span>
                                        </div>
                                        @if(item.StockQuantity > 0)
                                        {
                                            <span class="text-success small"><i class="bi bi-check-circle-fill"></i> Sẵn sàng</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger small"><i class="bi bi-x-circle-fill"></i> Hết hàng</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                <nav class="mt-5" aria-label="Page navigation">
                    <ul class="pagination pagination-modern justify-content-center shadow-sm">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageNumber="@(Model.CurrentPage - 1)"
                               asp-route-sortOrder="@Model.SortOrder"
                               asp-route-SearchString="@Model.SearchString"
                               asp-route-categoryId="@Model.CategoryId">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pageNumber="@i"
                                   asp-route-sortOrder="@Model.SortOrder"
                                   asp-route-SearchString="@Model.SearchString"
                                   asp-route-categoryId="@Model.CategoryId">@i</a>
                            </li>
                        }
                        
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageNumber="@(Model.CurrentPage + 1)"
                               asp-route-sortOrder="@Model.SortOrder"
                               asp-route-SearchString="@Model.SearchString"
                               asp-route-categoryId="@Model.CategoryId">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
            else
            {
                <div class="text-center py-5 bg-light rounded-4">
                    <i class="bi bi-search fs-1 text-muted opacity-50 mb-3 d-block"></i>
                    <h5 class="fw-bold text-secondary">Không tìm thấy sản phẩm nào</h5>
                    <p class="text-muted mb-4">Thử danh mục khác hoặc xóa bộ lọc.</p>
                    <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">Xóa tất cả bộ lọc</a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    function addToCart(productId) {
        $.ajax({
            url: '/Cart/AddToCart',
            type: 'POST',
            data: { 
                productId: productId, 
                quantity: 1 
            },
            success: function (response) {
                if (response.success) {
                    Swal.fire({
                        title: 'Thành công!',
                        text: 'Đã thêm vào giỏ hàng',
                        icon: 'success',
                        showConfirmButton: false, 
                        timer: 1000, 
                        timerProgressBar: true 
                    }).then(() => {
                        // Tùy chọn: reload hoặc cập nhật UI
                        // updateCartBadge(response.cartCount);
                    });
                } else {
                    Swal.fire('Lỗi!', response.message, 'error');
                }
            },
            error: function () {
                Swal.fire('Lỗi!', 'Không thể kết nối đến máy chủ. Vui lòng kiểm tra lại jQuery.', 'error');
            }
        });
    }
</script>
}
