@model SalesManagement.DAL.Entities.Product

<!-- Nhúng Partial View này vào cuối trang Chi Tiết Sản Phẩm (Details.cshtml) -->
<div class="product-reviews-section mt-5 pt-4 border-top">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold m-0"><i class="fas fa-star text-warning me-2"></i>Đánh giá sản phẩm</h3>
        <span class="badge bg-primary rounded-pill px-3 py-2 fs-6" id="reviewCountBadge">0 đánh giá</span>
    </div>

    <div class="row">
        <!-- Phần Form Đánh Giá -->
        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm border-0 bg-light rounded-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Gửi đánh giá của bạn</h5>
                    <form id="reviewForm">
                        <input type="hidden" id="reviewProductId" value="@Model.ProductId" />
                        
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">CHẤT LƯỢNG SẢN PHẨM</label>
                            <div class="rating-stars mb-2" dir="rtl">
                                <input type="radio" id="star5" name="rating" value="5" checked />
                                <label for="star5" title="Tuyệt vời - 5 sao">5 stars</label>
                                <input type="radio" id="star4" name="rating" value="4" />
                                <label for="star4" title="Tốt - 4 sao">4 stars</label>
                                <input type="radio" id="star3" name="rating" value="3" />
                                <label for="star3" title="Bình thường - 3 sao">3 stars</label>
                                <input type="radio" id="star2" name="rating" value="2" />
                                <label for="star2" title="Tệ - 2 sao">2 stars</label>
                                <input type="radio" id="star1" name="rating" value="1" />
                                <label for="star1" title="Rất tệ - 1 sao">1 star</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="reviewComment" class="form-label text-muted small fw-bold">NHẬN XÉT CỦA BẠN</label>
                            <textarea class="form-control rounded-3 border-0 shadow-sm" id="reviewComment" rows="4" placeholder="Chia sẻ cảm nhận về sản phẩm này..." required></textarea>
                        </div>
                        
                        <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold shadow-sm py-2">
                            <i class="fas fa-paper-plane me-2"></i> Gửi đánh giá
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Phần Hiển Thị Lịch Sử Đánh Giá -->
        <div class="col-lg-8">
            <div id="reviewsList" class="reviews-list-container pe-2">
                <!-- Data loaded via Ajax -->
                <div class="text-center py-5 text-muted">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <p>Đang tải đánh giá...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Custom Star Rating using pure CSS */
    .rating-stars {
        display: inline-flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
    }
    .rating-stars input {
        display: none;
    }
    .rating-stars label {
        color: #ddd;
        font-size: 28px;
        padding: 0 2px;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
    }
    .rating-stars label::before {
        content: '\2605'; /* Star icon HTML entity */
    }
    .rating-stars input:checked ~ label,
    .rating-stars label:hover,
    .rating-stars label:hover ~ label {
        color: #ffc107;
        transform: scale(1.1);
    }
    
    .review-item {
        transition: all 0.3s ease;
        border-left: 4px solid transparent;
    }
    .review-item:hover {
        background-color: #f8f9fa;
        border-left: 4px solid #0d6efd;
    }
    .verified-badge {
        font-size: 0.75rem;
        background: #e6fced;
        color: #00b0ff;
        padding: 4px 8px;
        border-radius: 4px;
        font-weight: bold;
    }
    .reviews-list-container {
        max-height: 600px;
        overflow-y: auto;
    }
    /* Custom Scrollbar */
    .reviews-list-container::-webkit-scrollbar {
        width: 6px;
    }
    .reviews-list-container::-webkit-scrollbar-track {
        background: #f1f1f1; 
        border-radius: 10px;
    }
    .reviews-list-container::-webkit-scrollbar-thumb {
        background: #ccc; 
        border-radius: 10px;
    }
    .reviews-list-container::-webkit-scrollbar-thumb:hover {
        background: #888; 
    }
</style>

<script>
    $(document).ready(function() {
        // Load Reviews initially
        loadReviews();

        // Handle Form Submission
        $('#reviewForm').submit(function(e) {
            e.preventDefault();
            
            const productId = $('#reviewProductId').val();
            const rating = $('input[name="rating"]:checked').val();
            const comment = $('#reviewComment').val();
            const btn = $(this).find('button[type="submit"]');

            if (!rating) {
                Swal.fire('Lỗi', 'Vui lòng chọn số sao đánh giá.', 'warning');
                return;
            }

            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang gửi...');

            $.ajax({
                url: '/ProductReviews/AddReview',
                type: 'POST',
                data: {
                    productId: productId,
                    rating: rating,
                    comment: comment
                },
                success: function(res) {
                    if (res.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công',
                            text: res.message,
                            timer: 2000,
                            showConfirmButton: false
                        });
                        $('#reviewComment').val('');
                        loadReviews(); // Reload data
                    } else {
                        if (res.message === "Vui lòng đăng nhập") {
                            window.location.href = '/Account/Login?ReturnUrl=' + window.location.pathname;
                        } else {
                            Swal.fire('Thông báo', res.message, 'error');
                        }
                    }
                },
                error: function() {
                    Swal.fire('Lỗi hệ thống', 'Vui lòng thử lại sau', 'error');
                },
                complete: function() {
                    btn.prop('disabled', false).html('<i class="fas fa-paper-plane me-2"></i> Gửi đánh giá');
                }
            });
        });
    });

    function loadReviews() {
        const productId = $('#reviewProductId').val();
        
        $.ajax({
            url: '/ProductReviews/GetReviews',
            type: 'GET',
            data: { productId: productId },
            success: function(res) {
                if (res.success && res.data) {
                    let html = '';
                    $('#reviewCountBadge').text(res.data.length + ' đánh giá');
                    
                    if (res.data.length === 0) {
                        html = `<div class="text-center py-5 bg-white rounded-4 border">
                                    <i class="far fa-comment-dots fa-3x text-light mb-3"></i>
                                    <p class="text-muted mb-0">Chưa có đánh giá nào cho sản phẩm này.<br>Hãy là người đầu tiên đánh giá!</p>
                                </div>`;
                    } else {
                        res.data.forEach(function(item) {
                            // Generate Stars
                            let starsHtml = '';
                            for (let i = 1; i <= 5; i++) {
                                starsHtml += i <= item.rating ? '<i class="fas fa-star text-warning small"></i>' : '<i class="far fa-star text-muted small"></i>';
                            }
                            
                            // Date format
                            const dateObj = new Date(item.createdDate);
                            const formattedDate = dateObj.toLocaleDateString("vi-VN") + ' ' + dateObj.toLocaleTimeString("vi-VN", {hour: '2-digit', minute:'2-digit'});

                            const verifiedTag = item.isVerifiedPurchase ? 
                                `<span class="verified-badge ms-2"><i class="fas fa-check-circle me-1"></i>Đã mua hàng</span>` : '';

                            const userAvatar = item.avatar ? item.avatar : 'https://ui-avatars.com/api/?name=' + encodeURIComponent(item.fullName || 'User') + '&background=random';

                            html += `
                            <div class="review-item bg-white p-4 mb-3 rounded-4 border shadow-sm">
                                <div class="d-flex align-items-start">
                                    <img src="${userAvatar}" class="rounded-circle me-3 border" style="width: 48px; height: 48px; object-fit:cover;">
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <h6 class="fw-bold mb-0">${item.fullName || 'Người dùng ẩn danh'} ${verifiedTag}</h6>
                                            <small class="text-muted"><i class="far fa-clock me-1"></i>${formattedDate}</small>
                                        </div>
                                        <div class="mb-2">${starsHtml}</div>
                                        <p class="mb-0 text-dark" style="line-height: 1.6;">${item.comment}</p>
                                    </div>
                                </div>
                            </div>`;
                        });
                    }
                    $('#reviewsList').html(html);
                }
            }
        });
    }
</script>
