@model SalesManagement.Web.Areas.Admin.Models.ProductReportViewModel
@{
    ViewData["Title"] = "Báo cáo Sản phẩm";
    var vn = new System.Globalization.CultureInfo("vi-VN");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark mb-0">
        <i class="bi bi-box-seam-fill text-primary me-2"></i>Báo cáo &amp; Phân tích
    </h3>
    <a asp-action="ExportProducts" class="btn btn-outline-success">
        <i class="bi bi-file-earmark-excel me-2"></i>Xuất CSV
    </a>
</div>

<partial name="_ReportTabs" />

<!-- ── KPI Cards ───────────────────────────────────────────────────────────── -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 kpi-card">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="kpi-icon text-primary"><i class="bi bi-archive-fill fs-2"></i></div>
                <div>
                    <div class="text-xs text-uppercase text-muted fw-bold mb-1">Tổng giá trị tồn kho</div>
                    <div class="h5 fw-bold mb-0">@Model.TotalInventoryValue.ToString("C0", vn)</div>
                    <div class="text-muted small mt-1">@Model.TotalItemsInStock.ToString("N0") sản phẩm</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 kpi-card">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="kpi-icon text-success"><i class="bi bi-arrow-repeat fs-2"></i></div>
                <div>
                    <div class="text-xs text-uppercase text-muted fw-bold mb-1">Vòng quay hàng tồn kho</div>
                    <div class="h5 fw-bold mb-0">@Model.InventoryTurnoverRate.ToString("F1")</div>
                    <div class="text-muted small mt-1">Lần / kỳ</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 kpi-card">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="kpi-icon text-danger"><i class="bi bi-exclamation-triangle-fill fs-2"></i></div>
                <div>
                    <div class="text-xs text-uppercase text-muted fw-bold mb-1">Sản phẩm sắp hết hàng</div>
                    <div class="h5 fw-bold mb-0 text-danger">@Model.LowStockProducts.Count</div>
                    <div class="text-muted small mt-1">Cần nhập thêm</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Top 10 best-sellers -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm mb-4 h-100">
            <div class="card-header bg-white py-3">
                <h6 class="m-0 fw-bold text-primary">
                    <i class="bi bi-trophy-fill me-2"></i>Top 10 Sản phẩm bán chạy
                </h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">#</th>
                                <th>Sản phẩm</th>
                                <th class="text-center">Đã bán</th>
                                <th class="text-end pe-3">Doanh thu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.TopSellingProducts.Any())
                            {
                                <tr><td colspan="4" class="text-center text-muted py-4">Không có dữ liệu</td></tr>
                            }
                            @for (int i = 0; i < Model.TopSellingProducts.Count; i++)
                            {
                                var item = Model.TopSellingProducts[i];
                                <tr>
                                    <td class="ps-3">
                                        @if (i == 0) { <span class="badge bg-warning text-dark">🥇</span> }
                                        else if (i == 1) { <span class="badge bg-secondary">🥈</span> }
                                        else if (i == 2) { <span class="badge bg-danger-subtle text-danger">🥉</span> }
                                        else { <span class="text-muted">@(i + 1)</span> }
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@item.ProductName</div>
                                        <small class="text-muted">@item.ProductCode</small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary-subtle text-primary rounded-pill px-2">
                                            @item.UnitsSold.ToString("N0")
                                        </span>
                                    </td>
                                    <td class="text-end pe-3 fw-semibold">
                                        @item.RevenueGenerated.ToString("C0", vn)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Low stock alert -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm mb-4 h-100">
            <div class="card-header bg-white py-3">
                <h6 class="m-0 fw-bold text-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i>Cảnh báo tồn kho thấp (dưới 10 sản phẩm)
                </h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Sản phẩm</th>
                                <th class="text-center">Tồn kho</th>
                                <th class="text-end pe-3">Giá trị</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.LowStockProducts.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-success py-4">
                                        <i class="bi bi-check-circle-fill me-2"></i>Tất cả sản phẩm có đủ hàng!
                                    </td>
                                </tr>
                            }
                            @foreach (var item in Model.LowStockProducts.Take(10))
                            {
                                var stockClass = item.StockQuantity == 0 ? "table-danger" : "table-warning";
                                <tr class="@stockClass">
                                    <td class="ps-3 fw-semibold">@item.Name</td>
                                    <td class="text-center">
                                        <span class="badge @(item.StockQuantity == 0 ? "bg-danger" : "bg-warning text-dark") rounded-pill">
                                            @item.StockQuantity
                                        </span>
                                    </td>
                                    <td class="text-end pe-3">@item.Value.ToString("C0", vn)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .kpi-card { transition: transform .2s, box-shadow .2s; }
    .kpi-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,.1) !important; }
    .kpi-icon { min-width: 48px; text-align: center; }
</style>
