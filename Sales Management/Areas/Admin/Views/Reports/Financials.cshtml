@model SalesManagement.Web.Areas.Admin.Models.FinancialReportViewModel
@{
    ViewData["Title"] = "Báo cáo Tài chính";
    var vn = new System.Globalization.CultureInfo("vi-VN");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark mb-0">
        <i class="bi bi-cash-coin text-primary me-2"></i>Báo cáo &amp; Phân tích
    </h3>
    <div class="text-muted small">
        <i class="bi bi-calendar3 me-1"></i>
        @Model.StartDate.ToString("dd/MM/yyyy") — @Model.EndDate.ToString("dd/MM/yyyy")
    </div>
</div>

<partial name="_ReportTabs" />

<!-- ── Filters ─────────────────────────────────────────────────────────────── -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form id="financialFilterForm" method="get" class="row g-3 align-items-center">
            <div class="col-auto">
                <label class="col-form-label fw-bold">Kỳ báo cáo:</label>
            </div>
            <div class="col-auto">
                <input type="date" name="startDate" id="finStartDate"
                       class="form-control"
                       value="@(Model.StartDate.ToString("yyyy-MM-dd"))"
                       disabled />
            </div>
            <div class="col-auto"><span class="text-muted">→</span></div>
            <div class="col-auto">
                <input type="date" name="endDate" id="finEndDate"
                       class="form-control"
                       value="@(Model.EndDate.ToString("yyyy-MM-dd"))"
                       disabled />
            </div>
            <div class="col-auto" id="finSpinner" style="display:none;">
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">Đang tải...</span>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- ── KPI Cards ───────────────────────────────────────────────────────────── -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 kpi-card border-start border-4 border-success">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="kpi-icon text-success"><i class="bi bi-arrow-down-circle-fill fs-2"></i></div>
                <div>
                    <div class="text-xs text-uppercase text-muted fw-bold mb-1">Tổng thu (Ví điện tử)</div>
                    <div class="h5 fw-bold mb-0 text-success">@Model.TotalCashIn.ToString("C0", vn)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 kpi-card border-start border-4 border-danger">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="kpi-icon text-danger"><i class="bi bi-arrow-up-circle-fill fs-2"></i></div>
                <div>
                    <div class="text-xs text-uppercase text-muted fw-bold mb-1">Tổng chi (Ví điện tử)</div>
                    <div class="h5 fw-bold mb-0 text-danger">@Model.TotalCashOut.ToString("C0", vn)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 kpi-card border-start border-4 border-primary">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="kpi-icon text-primary"><i class="bi bi-wallet2 fs-2"></i></div>
                <div>
                    <div class="text-xs text-uppercase text-muted fw-bold mb-1">Doanh thu thực (Đã thanh toán)</div>
                    <div class="h5 fw-bold mb-0 text-primary">@Model.NetRevenue.ToString("C0", vn)</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Chart + Invoice stats ──────────────────────────────────────────────── -->
<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="m-0 fw-bold text-primary">
                    <i class="bi bi-bar-chart-fill me-2"></i>Dòng tiền (Theo ngày)
                </h6>
            </div>
            <div class="card-body">
                <div id="finChartSkeleton" class="skeleton-box" style="height:350px;border-radius:8px;"></div>
                <div class="chart-area" id="cashFlowWrapper" style="height:350px; display:none;">
                    <canvas id="cashFlowChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4 h-100">
            <div class="card-header bg-white py-3">
                <h6 class="m-0 fw-bold text-dark">
                    <i class="bi bi-receipt-cutoff me-2"></i>Trạng thái Hóa đơn
                </h6>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    @foreach (var item in Model.InvoiceStats)
                    {
                        var (icon, colorClass, label) = item.Status switch
                        {
                            "Paid"     => ("bi-check-circle-fill", "text-success", "Đã thanh toán"),
                            "Pending"  => ("bi-clock-fill",        "text-warning", "Chờ thanh toán"),
                            _          => ("bi-x-circle-fill",     "text-danger",  "Hoàn tiền / Hủy")
                        };
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span>
                                <i class="bi @icon @colorClass me-2"></i>
                                @label
                            </span>
                            <div class="text-end">
                                <span class="d-block fw-bold">@item.TotalAmount.ToString("C0", vn)</span>
                                <small class="text-muted">@item.Count đơn</small>
                            </div>
                        </li>
                    }
                </ul>

                @{
                    var balance = Model.TotalCashIn - Model.TotalCashOut;
                    var balClass = balance >= 0 ? "text-success" : "text-danger";
                }
                <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                    <span class="fw-bold">Cân bằng ví</span>
                    <span class="fw-bold fs-6 @balClass">
                        @(balance >= 0 ? "+" : "")@balance.ToString("C0", vn)
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .kpi-card { transition: transform .2s, box-shadow .2s; }
    .kpi-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,.1) !important; }
    .kpi-icon { min-width: 48px; text-align: center; }
    .skeleton-box {
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: shimmer 1.4s infinite;
    }
    @@keyframes shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js" defer></script>
    <script>
    (function () {
        // ── Enable filters + debounce ─────────────────────────────────────────
        const form   = document.getElementById('financialFilterForm');
        const s      = document.getElementById('finStartDate');
        const e      = document.getElementById('finEndDate');
        const spinner = document.getElementById('finSpinner');
        s.disabled = false;
        e.disabled = false;

        let debounceTimer = null;
        function submitDebounced() {
            clearTimeout(debounceTimer);
            spinner.style.display = 'block';
            debounceTimer = setTimeout(() => form.submit(), 400);
        }
        s.addEventListener('change', submitDebounced);
        e.addEventListener('change', submitDebounced);

        // ── Chart ──────────────────────────────────────────────────────────────
        function initChart() {
            const labels  = @Html.Raw(Json.Serialize(Model.ChartLabels));
            const cashIn  = @Html.Raw(Json.Serialize(Model.CashInChartData));
            const cashOut = @Html.Raw(Json.Serialize(Model.CashOutChartData));

            document.getElementById('finChartSkeleton').style.display = 'none';
            document.getElementById('cashFlowWrapper').style.display  = 'block';

            const ctx = document.getElementById('cashFlowChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels,
                    datasets: [
                        { label: 'Tiền vào', data: cashIn,  backgroundColor: 'rgba(28,200,138,0.7)', hoverBackgroundColor: '#17a673' },
                        { label: 'Tiền ra',  data: cashOut, backgroundColor: 'rgba(231,74,59,0.7)',  hoverBackgroundColor: '#be2617' }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: { duration: 400 },
                    scales: {
                        x: { grid: { display: false } },
                        y: {
                            ticks: {
                                callback: v => new Intl.NumberFormat('vi-VN', {
                                    style: 'currency', currency: 'VND',
                                    maximumSignificantDigits: 3
                                }).format(v)
                            },
                            grid: { color: 'rgb(234,236,244)', drawBorder: false }
                        }
                    },
                    plugins: {
                        legend: { position: 'bottom' },
                        tooltip: {
                            callbacks: {
                                label: ctx => ctx.dataset.label + ': ' +
                                    new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(ctx.parsed.y)
                            }
                        }
                    }
                }
            });
        }

        if (typeof Chart !== 'undefined') initChart();
        else document.querySelector('script[src*="chart.js"]').addEventListener('load', initChart);
    })();
    </script>
}
