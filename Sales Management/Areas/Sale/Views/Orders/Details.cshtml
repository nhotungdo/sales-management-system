@model SalesManagement.DAL.Entities.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    Layout = "_SaleLayout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center px-4">
                    <div class="d-flex align-items-center">
                        <div class="card-icon bg-primary bg-opacity-10 text-primary me-3" style="width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-receipt"></i>
                        </div>
                        <h5 class="fw-bold mb-0 text-dark">
                            Đơn hàng #@Model.OrderId
                        </h5>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        @{
                            var badgeClass = Model.Status switch {
                                "Completed" => "bg-success",
                                "Confirmed" => "bg-primary",
                                "Pending" => "bg-warning",
                                "Cancelled" => "bg-danger",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass bg-opacity-10 text-@badgeClass.Replace("bg-", "") rounded-pill px-3 py-2">
                             <i class="bi bi-dot"></i> @Model.Status
                        </span>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 rounded-pill border">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại
                        </a>
                    </div>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    <!-- Status Management UI -->
                    <div class="bg-light p-4 rounded-4 mb-5 border">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <h6 class="fw-bold mb-1"><i class="bi bi-gear-fill me-2 text-primary"></i>Quản lý trạng thái</h6>
                                <p class="text-muted small mb-3 mb-md-0">Cập nhật tiến độ xử lý đơn hàng cho khách</p>
                            </div>
                            <div class="col-md-6">
                                <form asp-action="UpdateStatus" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="id" value="@Model.OrderId" />
                                    <select name="status" class="form-select rounded-pill px-3">
                                        <option value="Confirmed" selected="@(Model.Status == "Confirmed")">Xác nhận đơn</option>
                                        <option value="Completed" selected="@(Model.Status == "Completed")">Hoàn thành</option>
                                        <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Hủy đơn</option>
                                    </select>
                                    <button type="submit" class="btn btn-primary rounded-pill px-4">Cập nhật</button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4 mb-5">
                        <div class="col-md-6">
                            <h6 class="text-muted small text-uppercase fw-bold mb-3 ls-1">Thông tin khách hàng</h6>
                            <div class="card bg-white border p-3 rounded-4 shadow-sm">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center me-3" style="width: 42px; height: 42px;">
                                        <i class="bi bi-person-fill fs-5"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold mb-0">@Model.Customer?.FullName</h5>
                                        <span class="badge bg-light text-muted border-0 p-0 small">Customer ID: #@Model.CustomerId</span>
                                    </div>
                                </div>
                                <div class="text-muted small mb-2"><i class="bi bi-telephone-fill text-primary me-2"></i> @Model.Customer?.PhoneNumber</div>
                                <div class="text-muted small"><i class="bi bi-envelope-fill text-primary me-2"></i> @Model.Customer?.Email</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted small text-uppercase fw-bold mb-3 ls-1">Thông tin đơn hàng</h6>
                            <div class="card bg-white border p-3 rounded-4 shadow-sm">
                                <div class="d-flex justify-content-between mb-3 align-items-center">
                                    <span class="text-muted"><i class="bi bi-calendar-event me-2"></i>Ngày đặt:</span>
                                    <span class="fw-bold">@Model.OrderDate?.ToString("HH:mm - dd/MM/yyyy")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-3 align-items-center">
                                    <span class="text-muted"><i class="bi bi-credit-card me-2"></i>Thanh toán:</span>
                                    <span class="badge bg-light text-dark border">@Model.PaymentMethod</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted"><i class="bi bi-file-earmark-text me-2"></i>Hóa đơn:</span>
                                    <a asp-controller="Invoices" asp-action="Index" class="btn btn-sm btn-link p-0 text-decoration-none fw-bold">Xem hóa đơn liên kết <i class="bi bi-arrow-right-short"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h6 class="text-muted small text-uppercase fw-bold mb-3 ls-1">Danh sách sản phẩm</h6>
                    <div class="table-responsive mb-4 rounded-4 border overflow-hidden">
                        <table class="table align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4 py-3">Sản phẩm</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end pe-4">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detail in Model.OrderDetails)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark">@detail.Product?.Name</div>
                                            <small class="text-muted">Mã: @detail.Product?.Code</small>
                                        </td>
                                        <td class="text-center">@detail.Quantity</td>
                                        <td class="text-end text-muted">@detail.UnitPrice.ToString("N0") xu</td>
                                        <td class="text-end pe-4 fw-bold text-dark">@detail.Total?.ToString("N0") xu</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="row justify-content-end">
                        <div class="col-md-5">
                            <div class="card border-0 bg-primary bg-opacity-10 p-4 rounded-4">
                                <div class="d-flex justify-content-between mb-2 text-muted">
                                    <span>Tạm tính:</span>
                                    <span class="fw-bold">@Model.TotalAmount?.ToString("N0") xu</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2 text-muted">
                                    <span>Giảm giá:</span>
                                    <span>-0 xu</span>
                                </div>
                                <hr class="my-3 border-primary opacity-25" />
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5 class="fw-bold mb-0">Tổng thanh toán:</h5>
                                    <h4 class="fw-bold mb-0 text-primary">@Model.TotalAmount?.ToString("N0") xu</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .ls-1 { letter-spacing: 1px; }
    .table thead th { border-bottom: none; font-size: 0.75rem; color: #6c757d; }
    .btn-primary { background-color: var(--primary-color); border-color: var(--primary-color); }
</style>
