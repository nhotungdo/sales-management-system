@model SalesManagement.DAL.Entities.Invoice
@{
    ViewData["Title"] = "Chi tiết hóa đơn";
    Layout = "_SaleLayout";
    var payments = ViewBag.Payments as IEnumerable<SalesManagement.DAL.Entities.WalletTransaction>;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center px-4">
                    <div class="d-flex align-items-center">
                        <div class="card-icon bg-success bg-opacity-10 text-success me-3" style="width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-file-earmark-check fs-5"></i>
                        </div>
                        <h5 class="fw-bold mb-0 text-dark">Hóa đơn #INV-@Model.InvoiceId</h5>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-controller="InvoicePdf" asp-action="Export" asp-route-invoiceId="@Model.InvoiceId" class="btn btn-danger rounded-pill px-4 shadow-sm">
                            <i class="bi bi-file-earmark-pdf me-1"></i> Xuất PDF
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 rounded-pill border">
                            Quay lại
                        </a>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    <div class="row g-4 mb-5">
                        <div class="col-md-6">
                            <h6 class="text-muted small text-uppercase fw-bold mb-3 ls-1">Thông tin thanh toán</h6>
                            <div class="card bg-white border p-3 rounded-4 shadow-sm">
                                <div class="mb-3">
                                    <label class="text-muted small d-block">Khách hàng:</label>
                                    <span class="fw-bold fs-5">@Model.Order?.Customer?.FullName</span>
                                </div>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label class="text-muted small d-block">Ngày xuất:</label>
                                        <span class="fw-medium text-dark">@Model.InvoiceDate?.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                    <div class="col-6 text-end">
                                        <label class="text-muted small d-block">Trạng thái:</label>
                                        @{
                                            var badgeClass = Model.Status switch {
                                                "Paid" => "bg-success",
                                                "Issued" => "bg-warning",
                                                "Cancelled" => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @badgeClass bg-opacity-10 text-@badgeClass.Replace("bg-", "") rounded-pill px-3">@Model.Status</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted small text-uppercase fw-bold mb-3 ls-1">Đơn hàng liên kết</h6>
                            <div class="card bg-light border-0 p-3 rounded-4 shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted small">Mã đơn hàng:</span>
                                    <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId" class="fw-bold text-decoration-none">#ORD-@Model.OrderId <i class="bi bi-box-arrow-up-right small"></i></a>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted small">Phương thức:</span>
                                    <span class="badge bg-white text-dark border">@Model.Order?.PaymentMethod</span>
                                </div>
                                <hr class="my-3" />
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted small">Tổng hóa đơn:</span>
                                    <h4 class="fw-bold mb-0 text-primary">@Model.Amount.ToString("N0") xu</h4>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h6 class="text-muted small text-uppercase fw-bold mb-3 ls-1">Chi tiết hàng hóa</h6>
                    <div class="table-responsive mb-5 rounded-4 border">
                        <table class="table align-middle mb-0">
                            <thead class="bg-light text-muted small fw-bold">
                                <tr>
                                    <th class="ps-4">Sản phẩm</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end pe-4">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Order?.OrderDetails ?? new List<SalesManagement.DAL.Entities.OrderDetail>())
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark">@item.Product?.Name</div>
                                            <small class="text-muted">Mã: @item.Product?.Code</small>
                                        </td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end text-muted">@item.UnitPrice.ToString("N0") xu</td>
                                        <td class="text-end pe-4 fw-bold text-dark">@item.Total?.ToString("N0") xu</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <h6 class="text-muted small text-uppercase fw-bold mb-3 ls-1">Lịch sử giao dịch</h6>
                    <div class="card bg-white border rounded-4 overflow-hidden">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead class="bg-light small">
                                        <tr>
                                            <th class="ps-3 py-2">Thời gian</th>
                                            <th>Phương thức</th>
                                            <th>Mô tả</th>
                                            <th class="text-end pe-3">Số tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (payments != null && payments.Any())
                                        {
                                            foreach (var p in payments)
                                            {
                                                <tr>
                                                    <td class="ps-3 small text-muted">@p.CreatedDate?.ToString("HH:mm dd/MM/yy")</td>
                                                    <td>
                                                        <span class="badge bg-light text-dark border-0 p-0 text-uppercase small">@p.Method</span>
                                                    </td>
                                                    <td class="small">@p.Description</td>
                                                    <td class="text-end pe-3 fw-bold text-success">-@p.Amount.ToString("N0") xu</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="4" class="text-center py-4 text-muted italic small">Chưa có bản ghi giao dịch thanh toán nào</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .ls-1 { letter-spacing: 1px; }
    .table thead th { border-bottom: none; }
</style>
