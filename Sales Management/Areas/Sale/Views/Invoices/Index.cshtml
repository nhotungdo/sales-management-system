@model List<SalesManagement.DAL.Entities.Invoice>
@{
    ViewData["Title"] = "Quản lý hóa đơn";
    Layout = "_SaleLayout";
}

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center px-4">
            <div class="d-flex align-items-center">
                <div class="card-icon bg-primary bg-opacity-10 text-primary me-3" style="width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-receipt-cutoff fs-5"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-0 text-dark">Danh sách hóa đơn</h5>
                    <p class="text-muted small mb-0">Quản lý chứng từ và xác nhận thanh toán</p>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-light border rounded-pill px-3 fw-medium small">
                    <i class="bi bi-filter me-1"></i> Bộ lọc
                </button>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase fw-bold">
                        <tr>
                            <th class="ps-4 py-3">Mã HĐ</th>
                            <th>Đơn hàng</th>
                            <th>Khách hàng</th>
                            <th>Ngày xuất</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th class="text-center pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="fw-bold text-dark">#INV-@item.InvoiceId</span>
                                    </td>
                                    <td>
                                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@item.OrderId" class="text-decoration-none fw-medium text-primary">
                                            #ORD-@item.OrderId
                                        </a>
                                    </td>
                                    <td>
                                        <div class="fw-medium text-dark">@item.Order?.Customer?.FullName</div>
                                        <div class="small text-muted">@item.Order?.Customer?.PhoneNumber</div>
                                    </td>
                                    <td class="text-muted">@item.InvoiceDate?.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <span class="fw-bold text-dark">@item.Amount.ToString("N0") xu</span>
                                    </td>
                                    <td>
                                        @{
                                            var badgeClass = item.Status switch {
                                                "Paid" => "bg-success",
                                                "Issued" => "bg-warning",
                                                "Cancelled" => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                            var statusText = item.Status switch {
                                                "Paid" => "Đã thanh toán",
                                                "Issued" => "Đã xuất",
                                                "Cancelled" => "Đã hủy",
                                                _ => item.Status
                                            };
                                        }
                                        <span class="badge @badgeClass bg-opacity-10 text-@badgeClass.Replace("bg-", "") rounded-pill px-3">
                                            @statusText
                                        </span>
                                    </td>
                                    <td class="text-center pe-4">
                                        <div class="d-flex justify-content-center gap-2">
                                            <a asp-action="Details" asp-route-id="@item.InvoiceId" class="btn btn-sm btn-icon btn-light border rounded-circle shadow-sm" title="Xem chi tiết">
                                                <i class="bi bi-eye text-primary"></i>
                                            </a>
                                            <a asp-controller="InvoicePdf" asp-action="Export" asp-route-invoiceId="@item.InvoiceId" class="btn btn-sm btn-icon btn-light border rounded-circle shadow-sm" title="Xuất PDF">
                                                <i class="bi bi-file-earmark-pdf text-danger"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <i class="bi bi-receipt text-muted fs-1 d-block mb-3"></i>
                                    <span class="text-muted">Chưa có hóa đơn nào được tạo</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-icon { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; padding: 0; }
    .table thead th { border-bottom: none; font-size: 0.75rem; letter-spacing: 0.5px; }
</style>
