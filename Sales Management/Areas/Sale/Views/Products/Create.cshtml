@model SalesManagement.DAL.Entities.Product
@{
    ViewData["Title"] = "Thêm sản phẩm mới";
    Layout = "_SaleLayout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white py-3 border-0">
                    <h5 class="fw-bold mb-0"><i class="bi bi-plus-circle me-2"></i> Thêm sản phẩm mới</h5>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="Code" class="form-label small fw-bold text-uppercase text-muted">Mã sản phẩm</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-hash"></i></span>
                                    <input asp-for="Code" class="form-control border-start-0 ps-0" placeholder="VD: SP001" required />
                                </div>
                                <span asp-validation-for="Code" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label small fw-bold text-uppercase text-muted">Danh mục</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-folder2-open"></i></span>
                                    <select asp-for="CategoryId" class="form-select border-start-0 ps-0" asp-items="ViewBag.CategoryId"></select>
                                </div>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Name" class="form-label small fw-bold text-uppercase text-muted">Tên sản phẩm</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-box"></i></span>
                                    <input asp-for="Name" class="form-control border-start-0 ps-0" placeholder="Tên sản phẩm..." required />
                                </div>
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label small fw-bold text-uppercase text-muted">Mô tả</label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Nhập mô tả sản phẩm..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label small fw-bold text-uppercase text-muted">Hình ảnh sản phẩm</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-image"></i></span>
                                    <input type="file" name="imageFile" class="form-control border-start-0 ps-0" accept="image/*" onchange="previewImage(this)" />
                                </div>
                                <div class="mt-3">
                                    <img id="image-preview" src="#" alt="Preview" class="img-thumbnail d-none shadow-sm" style="max-height: 200px;">
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SellingPrice" class="form-label small fw-bold text-uppercase text-muted">Giá bán (xu)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-coin"></i></span>
                                    <input asp-for="SellingPrice" class="form-control border-start-0 ps-0" type="number" required />
                                </div>
                                <span asp-validation-for="SellingPrice" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="StockQuantity" class="form-label small fw-bold text-uppercase text-muted">Số lượng tồn</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-stack"></i></span>
                                    <input asp-for="StockQuantity" class="form-control border-start-0 ps-0" type="number" required />
                                </div>
                                <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label small fw-bold text-uppercase text-muted">Trạng thái</label>
                                <select asp-for="Status" class="form-select">
                                    <option value="Active">Hoạt động</option>
                                    <option value="Inactive">Tạm ngưng</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>

                            <div class="col-12 pt-4 d-flex gap-2">
                                <button type="submit" class="btn btn-primary-modern px-5 py-2 flex-grow-1">
                                    <i class="bi bi-check-lg me-2"></i> Lưu sản phẩm
                                </button>
                                <a asp-action="Index" class="btn btn-light px-4 py-2 border">Hủy bỏ</a>
                            </div>
                        </div>
                    </form>

                    <script>
                        function previewImage(input) {
                            var preview = document.getElementById('image-preview');
                            if (input.files && input.files[0]) {
                                var reader = new FileReader();
                                reader.onload = function (e) {
                                    preview.src = e.target.result;
                                    preview.classList.remove('d-none');
                                }
                                reader.readAsDataURL(input.files[0]);
                            }
                        }
                    </script>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-primary-modern {
        background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%);
        color: white;
        border: none;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
    }
    .btn-primary-modern:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.15);
        color: white;
    }
    .form-control:focus, .form-select:focus {
        border-color: #0d6efd;
        box-shadow: none;
    }
    .input-group-text {
        color: #6c757d;
    }
</style>
